# Configuração do Servidor HTTP
PORT=3333
NODE_ENV=development

# Chave Secreta de Autenticação da API
# Enviada pelos clientes nos cabeçalhos 'x-api-key: <token>' ou 'Authorization: Bearer <token>'
# Gere uma chave forte em produção (mínimo recomendado: 32 caracteres aleatórios)
API_SECRET_KEY=sua_chave_secreta_aqui

# Cookies de Sessão do Google Gemini Web
# Dica: execute 'npm run login' para preencher e renovar estes campos automaticamente via navegador
GEMINI_SECURE_1PSID=insira_aqui_seu_cookie_secure_1psid
GEMINI_SECURE_1PSIDTS=insira_aqui_seu_cookie_secure_1psidts
GEMINI_SECURE_1PSIDCC=insira_aqui_seu_cookie_secure_1psidcc
GEMINI_SID=insira_aqui_seu_cookie_sid
GEMINI_HSID=insira_aqui_seu_cookie_hsid
GEMINI_SSID=insira_aqui_seu_cookie_ssid

# URL Base Pública da Aplicação (usada para montar links de vídeo, imagem e áudio)
# Local: http://localhost:3333/api2
# Produção: https://api.example.com/api2
BASE_URL=http://localhost:3333/api2

# Armazenamento e Perfil Persistente do Navegador
STORAGE_DIR=./storage/media
CHROME_PROFILE_DIR=./storage/chrome-profile

# Caminho opcional do executável Google Chrome / Chromium (detectado automaticamente se omitido)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Timeouts, Retenção e Renovação de Sessão
GEMINI_TIMEOUT_MS=300000
MEDIA_MAX_AGE_HOURS=4
COOKIE_REFRESH_HOURS=3

# Ambiente Corporativo / Firewall / Proxy com inspeção SSL (opcional)
# Descomente a linha abaixo caso receba o erro: "self-signed certificate in certificate chain"
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Segurança e Limites Opcionais
# CORS_ORIGIN=*
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
